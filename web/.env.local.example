# Copy to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only, used to bypass RLS for the token-based approver route (Phase 3).
SUPABASE_SERVICE_ROLE_KEY=

# Approval emails (Phase 3) — sent via Gmail/Google Workspace SMTP, not a
# dedicated ESP. Google Account -> Security -> 2-Step Verification -> App
# passwords -> generate one for "Mail". GMAIL_USER is the sending address;
# GMAIL_APP_PASSWORD is the 16-character app password (not your real
# password). Verify with `npm run email:test -- you@example.com`.
GMAIL_USER=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=Lub d Voucher System
# 587 = STARTTLS (default if left blank), 465 = implicit TLS/SSL. Avoid 25 —
# Vercel (and most cloud/serverless hosts) block outbound port 25 as an
# anti-spam measure, so it can work from a local machine and then fail with
# `connect ETIMEDOUT ...:25` in production. Confirmed the hard way once.
GMAIL_SMTP_PORT=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Authorizes Vercel Cron's daily call to /api/cron/expire-vouchers — must
# also be set as an env var on the Vercel project (Vercel sends it
# automatically as `Authorization: Bearer $CRON_SECRET` once configured
# there). Generate with: openssl rand -base64 32
CRON_SECRET=

# Recipient for the monthly DB-backup cron (api/cron/monthly-backup) — a
# zipped JSON dump of every table (minus the Gmail app password), emailed
# on the 1st of each month in lieu of paying for Supabase's own backup add-on.
BACKUP_EMAIL_TO=
